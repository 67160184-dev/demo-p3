# Server Configuration
PORT=3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=product_db
DB_PORT=3306

# JWT (login ของ admin) — JWT_SECRET ต้องเป็นค่าสุ่มยาวๆ สร้างด้วย:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h

# External API (Exchange rate) — ใช้ตอนจำลอง failure ได้ เช่น ตั้ง URL ผิด
EXCHANGE_API_URL=https://open.er-api.com/v6/latest/THB
EXTERNAL_API_TIMEOUT_MS=3000
EXTERNAL_API_MAX_RETRIES=2
EXTERNAL_API_BACKOFF_MS=500
